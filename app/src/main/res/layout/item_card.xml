<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <data>

        <variable
            name="cardTitle"
            type="String" />

        <variable
            name="cardIcon"
            type="android.graphics.drawable.Drawable" />


        <variable
            name="viewModelData"
            type="com.altaf.haryanalast.ui.home.viewmodel.HomeViewModel" />

        <variable
            name="cardType"
            type="String" />
    </data>


    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="@dimen/_3sdp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="@color/_11000000"
        android:onClick="@{() -> viewModelData.onCardClick(cardType)}">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">


            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@{cardIcon}"
                tools:src="@drawable/ic_prize" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{cardTitle}"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/_9sdp"
                tools:text="Card Title" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
